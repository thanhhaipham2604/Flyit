# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o-mini

# Reciprocal-rank-fusion damping: score = 1 / (RRF_K + rank). Must be >= 1.
# 60 is the shipped default; ADR-0004 records the sweep behind it.
RRF_K=60

CORPUS_DIR=data/ato_corpus
INDEX_DIR=data/index

# Postgres + pgvector — one store, both retrieval halves (see ADR-0002)
DATABASE_URL=postgresql://fylit:fylit@localhost:5432/fylit
CHUNKS_TABLE=chunks

API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_PER_MINUTE=30
